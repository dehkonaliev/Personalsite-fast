# Database (FastAPI Cloud -> Neon integration sets DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Admin API protection. Leave empty to disable /api/admin entirely.
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# Public API URL. Optional: FastAPI Cloud sets FASTAPI_PUBLIC_URL for custom domains.
# PUBLIC_BASE_URL=https://dehkonaliev.uz
# CORS origins (comma separated)
CORS_ORIGINS=https://dehkonaliev.uz,https://www.dehkonaliev.uz,https://personal-site-frontend-sepia.vercel.app,http://localhost:5173

# Tables are created automatically on first deploy when the database is empty.
AUTO_CREATE_TABLES=true
PAGE_SIZE=10
MAX_UPLOAD_MB=25

# S3-compatible storage (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
# Leave S3_BUCKET empty to store uploads on the local filesystem.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoint for R2/Spaces/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Public bucket/CDN root, e.g. https://cdn.dehkonaliev.uz
S3_PUBLIC_BASE_URL=
S3_PREFIX=media
S3_USE_SSL=true
S3_ADDRESSING_STYLE=auto
S3_ACL=
# Use presigned URLs when the bucket is private.
S3_PRESIGNED_URLS=false
S3_PRESIGN_EXPIRES=3600
